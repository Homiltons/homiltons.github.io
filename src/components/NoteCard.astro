---
interface Props { href: string; title: string; description: string; category: string; date: Date; }
const { href, title, description, category, date } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(date);
---

<article class="note-card">
  <p class="note-meta"><span>{category}</span><span>{formattedDate}</span></p>
  <h2><a href={href}>{title}</a></h2><p>{description}</p>
  <a class="text-link" href={href}>Read note <span aria-hidden="true">↗</span></a>
</article>
