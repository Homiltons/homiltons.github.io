---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'zh-CN';
}

const { title, description = site.description, image, lang = 'en' } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = image ? new URL(image, site.url) : undefined;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  additionalName: site.chineseName,
  url: site.url,
  image: `${site.url}/images/profile/hongming-wang.jpg`,
  jobTitle: 'AI Researcher',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Southern University of Science and Technology',
  },
  sameAs: site.socials.map((item) => item.href),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#101310" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
