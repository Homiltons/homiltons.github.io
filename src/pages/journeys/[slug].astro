---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { journeys, type Journey } from '../../data/journeys';

export function getStaticPaths() {
  return journeys.map((journey) => ({ params: { slug: journey.slug }, props: { journey } }));
}

interface Props { journey: Journey; }
const { journey } = Astro.props;
---

<BaseLayout title={journey.location} description={journey.summary} image={journey.cover}>
  <header class="page-hero">
    <div class="shell"><a class="back-link" href="/journeys/">← All journeys</a><p class="eyebrow">{journey.location} · {journey.date}</p><h1>{journey.title}</h1><p>{journey.summary}</p></div>
  </header>
  <section class="section"><div class="shell gallery">{journey.images.map((image, index) => <img src={image} alt={`${journey.location}, photograph ${index + 1}`} loading={index > 1 ? 'lazy' : 'eager'} />)}</div></section>
</BaseLayout>
