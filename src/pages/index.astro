---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationCard from '../components/PublicationCard.astro';
import JourneyFeature from '../components/JourneyFeature.astro';
import NoteCard from '../components/NoteCard.astro';
import { site } from '../data/site';
import { news } from '../data/news';
import { publications } from '../data/publications';
import { journeys } from '../data/journeys';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const socialPresentation = {
  'Google Scholar': { mark: '∑', note: 'Papers & citations', tone: 'scholar' },
  GitHub: { mark: '<>', note: 'Code & projects', tone: 'github' },
  X: { mark: 'X', note: 'Thoughts & links', tone: 'x' },
  LinkedIn: { mark: 'in', note: 'Professional profile', tone: 'linkedin' },
} as const;
---

<BaseLayout image="/images/hero/wadim-kashin-glitch.jpg">
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">AI researcher · Digital garden</p>
        <h1>Hi! I’m<br />Hongming Wang.</h1>
        <p class="hero-subtitle">
          I study large language models, agents, and intelligent interaction — and keep notes on the ideas, places, and people that shape the journey.
        </p>
        <div class="hero-actions">
          <a class="button button-light" href="/research/">Explore my research</a>
          <a class="button button-ghost" href="/journeys/">Beyond the lab</a>
        </div>
        <div class="hero-aside">
          <span>Incoming Ph.D. student · Nanjing University</span>
          <span>LLM reasoning · Agents · AI for Science</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell intro-grid">
      <div class="portrait-column">
        <figure class="portrait-figure">
          <div class="portrait-wrap">
            <img src="/images/profile/hongming-wang.jpg" alt="Hongming Wang at the Hong Kong Museum of Art" />
          </div>
          <figcaption>Photo by Xin Chen at <em>Hong Kong</em>.</figcaption>
        </figure>
        <div class="social-list portrait-socials" aria-label="Social profiles">
          {site.socials.map((item) => {
            const profile = socialPresentation[item.label as keyof typeof socialPresentation];
            return (
              <a class={`social-card social-card-${profile.tone}`} href={item.href} target="_blank" rel="noreferrer">
                <span class="social-mark" aria-hidden="true">{profile.mark}</span>
                <span class="social-copy"><strong>{item.label}</strong><small>{profile.note}</small></span>
              </a>
            );
          })}
        </div>
      </div>
      <div class="intro-copy">
        <p class="eyebrow">About me</p>
        <h2>Building intelligent systems for discovery and real-world interaction.</h2>
        <p>
          I am currently completing my master’s degree at
          <a href="https://www.sustech.edu.cn/">SUSTech</a>, advised by
          <a href="https://minyang.me/">Prof. Min Yang</a> and
          <a href="https://cs.nju.edu.cn/shiyh/">Prof. Yinghuan Shi</a>. I will join
          <a href="https://www.nju.edu.cn/">Nanjing University</a> as a Ph.D. student in Fall 2026.
        </p>
        <p>
          My work focuses on LLM reasoning, agents, deep research, GUI intelligent interaction, and AI for Science. Outside research, I enjoy tennis, music, photography, and getting lost in a new city.
        </p>
        <div class="button-row">
          <a class="button" href="/about/">More about me</a>
          <a class="text-link" href={`mailto:${site.email}`}>Start a conversation ↗</a>
        </div>
        <div class="news-block">
          <div class="news-heading">
            <span class="news-signal" aria-hidden="true"></span>
            <div><p>From the lab & beyond</p><h3>Recent news</h3></div>
          </div>
          <div class="news-scroll" tabindex="0" aria-label="Recent news, scroll for more updates">
            <ol class="news-list">
              {news.map((item) => (
                <li>
                  <time datetime={item.date}>{item.displayDate}</time>
                  <a href={item.href} target="_blank" rel="noreferrer">{item.text}</a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell">
      <SectionHeading eyebrow="Selected work" title="Research with a path toward useful, trustworthy AI." href="/research/" linkLabel="All research" />
      <div id="home-publications" class="publication-list expandable-collection" data-expanded="false">
        {publications.map((publication) => <div class="expandable-item"><PublicationCard publication={publication} /></div>)}
      </div>
      {publications.length > 2 && (
        <button
          class="expand-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="home-publications"
          data-expand-toggle="home-publications"
          data-open-label="Show all publications"
          data-close-label="Show latest publications only"
        >Show all publications</button>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Working notes"
        title="Ideas are better when they stay inspectable."
        description="Reading notes, mathematical derivations, algorithm practice, and lessons from building AI systems."
        href="/notes/"
        linkLabel="Browse notes"
      />
      {notes.length > 0 ? (
        <div class="note-grid">
          {notes.map((note) => (
            <NoteCard
              href={`/notes/${note.id}/`}
              title={note.data.title}
              description={note.data.description}
              category={note.data.category}
              date={note.data.publishedAt}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state"><p>The note system is ready. The first long-form reading, math, and algorithm notes will appear here as they are edited for publication.</p></div>
      )}
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell">
      <SectionHeading eyebrow="Journeys" title="A life measured in more than papers and deadlines." href="/journeys/" linkLabel="See all journeys" />
      <div id="home-journeys" class="journey-feature-list expandable-collection" data-expanded="false">
        {journeys.map((journey) => <div class="expandable-item"><JourneyFeature journey={journey} /></div>)}
      </div>
      {journeys.length > 2 && (
        <button
          class="expand-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="home-journeys"
          data-expand-toggle="home-journeys"
          data-open-label="Show all journeys"
          data-close-label="Show latest journeys only"
        >Show all journeys</button>
      )}
    </div>
  </section>

  <script>
    document.querySelectorAll('[data-expand-toggle]').forEach((element) => {
      if (!(element instanceof HTMLButtonElement)) return;
      element.addEventListener('click', () => {
        const targetId = element.dataset.expandToggle;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        const expanded = element.getAttribute('aria-expanded') === 'true';
        element.setAttribute('aria-expanded', String(!expanded));
        target.dataset.expanded = String(!expanded);
        element.textContent = expanded
          ? element.dataset.openLabel ?? 'Show all'
          : element.dataset.closeLabel ?? 'Show less';
      });
    });
  </script>
</BaseLayout>
